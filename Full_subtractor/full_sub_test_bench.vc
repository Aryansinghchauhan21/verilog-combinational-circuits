module tb;
  reg a, b, bin;
  wire diff, bout;

  full_sub abc(a,b,bin,diff,bout);


  initial begin
    $monitor("Time =%0t, a = %b, b = %b, bin = %b, diff = %b, bout =%b", $time, a, b, bin, diff, bout);
    for(int i =0; i < 9; i++)
      begin
        {a,b,bin} = i;
        #1;
      end
    #1;
    $finish;
  end
  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0, tb);
  end
endmodule

    
  
